################################################################################
# Add-on: HAOS Kiosk Display (haoskiosk)
# File: xorg.conf (Default Baseline)
# Version: 1.3.2 (Forked/Updated)
# Date: August 2026
#
# Minimal xorg.conf to work with OpenGL/DRI video and libinput mice & keyboards.
#
# NOTE: The "kmsdev" (Video Card) mapping and the "TransformationMatrix" 
# (Touchscreen Rotation) are intentionally omitted here. They are dynamically 
# calculated and injected by the run.sh script at startup based on host hardware 
# and user configuration.
################################################################################

Section "ServerLayout"
    Identifier      "DefaultLayout"
    Screen          0  "Screen0" 0 0
EndSection

Section "Device"
    Identifier      "Card0"
    Driver          "modesetting"
    Option          "DRI" "3"
    # run.sh will dynamically inject Option "kmsdev" "/dev/dri/cardX" below this line
EndSection

Section "Monitor"
    Identifier      "Monitor0"
EndSection

Section "Screen"
    Identifier      "Screen0"
    Device          "Card0"
    Monitor         "Monitor0"
    DefaultDepth    24
EndSection

# General libinput catchall for keyboards
Section "InputClass"
    Identifier      "libinput keyboard"
    MatchIsKeyboard "on"
    Driver          "libinput"
    Option          "GrabDevice" "true"
EndSection

# General libinput catchall for mice and touchpads
Section "InputClass"
    Identifier      "libinput pointer"
    MatchIsPointer  "on"
    Driver          "libinput"
    Option          "Tapping" "on"  # Enable tapping on touchpads
    Option          "NaturalScrolling" "true"  # Optional: enable natural scrolling
EndSection

# General libinput catchall for touchscreens
Section "InputClass"
    Identifier         "libinput touchscreen"
    MatchIsTouchscreen "on"
    Driver             "libinput"
    Option             "Tapping" "on"
    Option             "TappingDrag" "on"  # Enables tap-and-drag
    # run.sh will dynamically append the ROTATE_DISPLAY TransformationMatrix at the end of the file
EndSection
